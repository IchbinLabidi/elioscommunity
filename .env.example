VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key

# GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN and GOOGLE_CALENDAR_ID
# must be stored as Supabase Edge Function secrets, never in VITE_* variables.

# SUPABASE_SERVICE_ROLE_KEY is also an Edge Function secret only.
# It is required server-side for direct current-user email updates and must never be exposed here.
# SUPABASE_ANON_KEY is required by the update-current-user-email Edge Function to validate the caller JWT.
